<Window x:Class="AlertingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem | Secure access"
        Width="900" Height="680"
        MinWidth="420" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0B0F14"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#151F29"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#101820"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A3845"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#169C98"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F6F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A4B2BD"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#147F82"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#14252B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#14252B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A6F0E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border MaxWidth="440"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Welcome"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Grid>
                        <StackPanel x:Name="LoginFormPanel">
                            <TextBlock Text="Username"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="LoginUsernameTextBox"
                                     AutomationProperties.Name="Username"
                                     MaxLength="32"
                                     HorizontalAlignment="Stretch"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Password"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7"/>
                            <PasswordBox x:Name="LoginPasswordBox"
                                         AutomationProperties.Name="Password"
                                         KeyDown="LoginPasswordBox_KeyDown"
                                         Margin="0,0,0,20"/>

                            <Button x:Name="LoginButton"
                                    Content="Sign in"
                                    Click="LoginButton_Click"
                                    Height="46"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                            <TextBlock Text="Display name"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterDisplayNameTextBox"
                                     AutomationProperties.Name="Display name"
                                     MaxLength="100"
                                     Margin="0,0,0,11"
                                     PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Username"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterUsernameTextBox"
                                     AutomationProperties.Name="New username"
                                     MaxLength="32"
                                     Margin="0,0,0,11"
                                     PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Password (8+ characters)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="RegisterPasswordBox"
                                         AutomationProperties.Name="New password"
                                         Margin="0,0,0,11"
                                         PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Confirm password"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         AutomationProperties.Name="Confirm password"
                                         Margin="0,0,0,15"
                                         PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <Button x:Name="RegisterButton"
                                    Content="Create account"
                                    Click="RegisterButton_Click"
                                    Height="46"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock x:Name="FeedbackText"
                               Text=""
                               FontSize="11"
                               Foreground="#FF879B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <Button x:Name="ModeSwitchButton"
                            Content="New here? Create an account"
                            Click="ModeSwitchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#7BD8D1"
                            HorizontalAlignment="Center"
                            Padding="8,7"
                            MinHeight="34"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
