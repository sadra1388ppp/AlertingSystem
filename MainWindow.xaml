<Window x:Class="AlertingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem"
        Width="1220" Height="760"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1120"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#111B2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26344D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A2BB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FB7185"/>
        <SolidColorBrush x:Key="NeutralBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1A2942"/>
        <SolidColorBrush x:Key="SelectedFilterBrush" Color="#2563EB"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#91A2BB"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18253B"/>
                    <Setter Property="Foreground" Value="#EEF3FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1A2942"/>
            <Setter Property="Foreground" Value="#D8E4F5"/>
        </Style>

        <Style x:Key="IncidentListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Delete incident" Click="DeleteIncidentMenuItem_Click"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#14233A"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1424"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,34">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB">
                        <TextBlock Text="A" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AlertingSystem" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="MONITORING" FontSize="9" Margin="0,3,0,0"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Foreground="#71829C"
                               FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/>
                    <Button x:Name="OverviewNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="▦   Endpoint checker" Click="OverviewNavButton_Click"
                            Background="#1D3152" Foreground="#EAF2FF" FontWeight="SemiBold"/>
                    <Button x:Name="IncidentsNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="◉   Incidents" Click="IncidentsNavButton_Click"/>
                    <Button x:Name="AlertHistoryNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="◷   Alert history" Click="AlertHistoryNavButton_Click"/>
                    <TextBlock Text="⚙   Settings (coming later)" Margin="11,19,0,0"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="COMING NEXT" Margin="4,31,0,0" FontSize="9"
                               FontWeight="Bold" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text=" Local test mode" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="v0.1 • First build" FontSize="10"
                               Foreground="#64748B" Margin="3,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid x:Name="OverviewPage" Grid.Column="1" Margin="28,25,28,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Endpoint monitor" FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Run a real HTTP check and see whether a service responds."
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#66531F" Background="#2B2413"
                        BorderThickness="1" CornerRadius="8" Padding="12,9"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MANUAL CHECKS" FontSize="10" FontWeight="Bold"
                                   Foreground="#FDE68A"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Summary cards -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CHECKS RUN" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ChecksRunText" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Text="This session" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="LATEST RESULT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="LastResultSummaryText" Text="Not checked" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,10,0,3"/>
                        <TextBlock Text="Updates after each check" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16">
                    <StackPanel>
                        <TextBlock Text="RESPONSE TIME" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ResponseTimeSummaryText" Text="—" FontSize="28"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Time to receive response headers" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Main panels -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- Endpoint check -->
                <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Check a service" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Enter a public website or API endpoint to test its HTTP response."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock Text="ENDPOINT URL" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="EndpointTextBox" Text="https://example.com"
                                     AutomationProperties.Name="Endpoint URL"/>
                        </StackPanel>

                        <Button x:Name="CheckEndpointButton" Grid.Row="2"
                                Content="Check endpoint" Click="CheckEndpoint_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>

                        <Border Grid.Row="3" Background="#0C1424" CornerRadius="9"
                                Padding="14" Margin="0,22,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusIndicator" Width="9" Height="9"
                                             Fill="{StaticResource NeutralBrush}"
                                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="CheckStatusText" Text="Ready to check"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="LastResultText"
                                           Text="No request has been sent yet."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock x:Name="ResponseTimeText" Text="Response time: —"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="4" Margin="0,22,0,10">
                            <TextBlock Text="Recent checks" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="The latest 10 attempts appear here."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="HistoryList" Grid.Row="5"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontSize="11" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- Scope and next steps -->
                <StackPanel Grid.Column="1">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="What this test tells you" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Healthy means the endpoint returned a 2xx HTTP status. Other HTTP responses, connection failures, and timeouts are shown separately."
                                       FontSize="12" LineHeight="19"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="2xx — successful HTTP response" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="4xx / 5xx — HTTP error response" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Timeout / unreachable — no usable response" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#14233A" BorderBrush="#294568" BorderThickness="1"
                            CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Incident overview" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Failed checks create incidents, and successful checks can resolve them."
                                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OverviewOpenIncidentsCountText" Text="0 open incidents"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"/>
                            <Button Content="Open incidents" Style="{StaticResource SecondaryButton}"
                                    Click="IncidentsNavButton_Click" HorizontalAlignment="Left"
                                    Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Prototype • Checks run only when you click the button."
                               FontSize="10" Foreground="#64748B" TextWrapping="Wrap"
                               Margin="4,14,4,0"/>
                </StackPanel>
            </Grid>
        </Grid>

    <Grid x:Name="IncidentsPage" Grid.Column="1" Margin="28,25,28,25" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Incident management" FontSize="27" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Failures from endpoint checks are tracked here until they recover or you resolve them."
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}"
                    Background="{StaticResource CardBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" VerticalAlignment="Center">
                <TextBlock Text="INCIDENTS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}"/>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,18">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="OPEN INCIDENTS" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="OpenIncidentCountText" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="Not yet resolved" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="16">
                <StackPanel>
                    <TextBlock Text="DONE INCIDENTS" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="DoneIncidentCountText" Text="0" FontSize="28"
                               FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="Finished incidents" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Incident list" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="IncidentFilterDescriptionText" Text="Showing open incidents"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="OpenIncidentsFilterButton" Content="Open"
                                    Style="{StaticResource SecondaryButton}" Click="OpenIncidentsFilterButton_Click"
                                    Margin="0,0,7,0" Padding="12,8"/>
                            <Button x:Name="AllIncidentsFilterButton" Content="All"
                                    Style="{StaticResource SecondaryButton}" Click="AllIncidentsFilterButton_Click"
                                    Padding="12,8"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button x:Name="MarkDoneIncidentButton" Content="Mark as done"
                                Click="MarkDoneIncidentButton_Click" IsEnabled="False"
                                Padding="12,9"/>
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <ListBox x:Name="IncidentsListBox" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource IncidentListBoxItemStyle}"
                             SelectionChanged="IncidentsListBox_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101A2B" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="{Binding SeverityBrush}" CornerRadius="5"
                                                    Padding="7,3" Margin="0,0,9,0">
                                                <TextBlock Text="{Binding SeverityDisplay}" FontSize="10"
                                                           FontWeight="Bold" Foreground="#0B1120"/>
                                            </Border>
                                            <TextBlock Text="{Binding IncidentNumber}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding StatusDisplay}" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,11,0,0"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding EndpointUrl}"
                                                   FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{StaticResource NeutralBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Details}"
                                                   FontSize="12" Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding ActivityDisplay}"
                                                   FontSize="10" Margin="0,10,0,0"
                                                   Foreground="#71829C" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding ResolutionNote}"
                                                   FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="IncidentsEmptyText" Text="No open incidents. Run a failing endpoint check to test incident creation."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                               FontSize="13" Foreground="{StaticResource MutedBrush}"
                               Margin="20" IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>

    <Grid x:Name="AlertHistoryPage" Grid.Column="1" Margin="28,25,28,25" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Alert history" FontSize="27" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="A local record of endpoint checks and their outcomes."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="15" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Recent check events" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Up to 200 entries are kept on this computer."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="HistoryCountText" Grid.Column="1" Text="0 records"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18">
            <Grid>
                <ListBox x:Name="HistoryEntriesList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Delete history entry" Click="DeleteHistoryEntryMenuItem_Click"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101A2B" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.RowSpan="2" Text="{Binding TimestampDisplay}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                               Foreground="{StaticResource TextBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding ResultBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding ResponseTimeDisplay}" FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyText" Text="No checks yet. Run a check from Endpoint checker."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
