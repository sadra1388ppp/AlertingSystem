<Window x:Class="AlertingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem"
        Width="1360" Height="840"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Hex0A1020Brush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A1020"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D1628"/>
        <SolidColorBrush x:Key="CardBrush" Color="#121E33"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263650"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAAC2"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#3DD9A0"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F6C65B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF718B"/>
        <SolidColorBrush x:Key="NeutralBrush" Color="#72A7FF"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#1B2A44"/>
        <SolidColorBrush x:Key="SelectedFilterBrush" Color="#477DFA"/>

        <!-- Runtime-switchable literal colors for Dark and Light themes. -->
        <SolidColorBrush x:Key="Hex0A1020Brush" Color="#0A1020"/>
        <SolidColorBrush x:Key="Hex0B1120Brush" Color="#0B1120"/>
        <SolidColorBrush x:Key="Hex0B1425Brush" Color="#0B1425"/>
        <SolidColorBrush x:Key="Hex101A2BBrush" Color="#101A2B"/>
        <SolidColorBrush x:Key="Hex101B2FBrush" Color="#101B2F"/>
        <SolidColorBrush x:Key="Hex14233ABrush" Color="#14233A"/>
        <SolidColorBrush x:Key="Hex162743Brush" Color="#162743"/>
        <SolidColorBrush x:Key="Hex18253BBrush" Color="#18253B"/>
        <SolidColorBrush x:Key="Hex1A2942Brush" Color="#1A2942"/>
        <SolidColorBrush x:Key="Hex20385FBrush" Color="#20385F"/>
        <SolidColorBrush x:Key="Hex294568Brush" Color="#294568"/>
        <SolidColorBrush x:Key="Hex302713Brush" Color="#302713"/>
        <SolidColorBrush x:Key="Hex3B82F6Brush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Hex477DFABrush" Color="#477DFA"/>
        <SolidColorBrush x:Key="Hex5C8CFFBrush" Color="#5C8CFF"/>
        <SolidColorBrush x:Key="Hex64748BBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="Hex71829CBrush" Color="#71829C"/>
        <SolidColorBrush x:Key="Hex75602ABrush" Color="#75602A"/>
        <SolidColorBrush x:Key="Hex91A2BBBrush" Color="#91A2BB"/>
        <SolidColorBrush x:Key="HexD8E4F5Brush" Color="#D8E4F5"/>
        <SolidColorBrush x:Key="HexEAF2FFBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="HexEEF3FABrush" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="HexFDE68ABrush" Color="#FDE68A"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Hex477DFABrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hex5C8CFFBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Hex91A2BBBrush}"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hex18253BBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HexEEF3FABrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Hex1A2942Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HexD8E4F5Brush}"/>
        </Style>

        <Style x:Key="ScheduleUnitSegmentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="IncidentListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Delete incident"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hex14233ABrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Hex3B82F6Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Hex0B1425Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Hex477DFABrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource Hex477DFABrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOptionRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ThemeOptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource Hex477DFABrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="Background" Value="{DynamicResource Hex20385FBrush}"/>
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource Hex477DFABrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThemeOptionBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,34">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Hex477DFABrush}">
                        <TextBlock Text="A" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AlertingSystem" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="MONITORING" FontSize="9" Margin="0,3,0,0"
                                   FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Foreground="{DynamicResource Hex71829CBrush}"
                               FontSize="10" FontWeight="Bold" Margin="4,0,0,12"/>
                    <Button x:Name="OverviewNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="▦   Endpoint checker" Click="OverviewNavButton_Click"
                            Background="{DynamicResource Hex20385FBrush}" Foreground="{DynamicResource HexEAF2FFBrush}" FontWeight="SemiBold"/>
                    <Button x:Name="ScheduledChecksNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="⟳   Scheduled checks" Click="ScheduledChecksNavButton_Click"/>
                    <Button x:Name="IncidentsNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="◉   Incidents" Click="IncidentsNavButton_Click"/>
                    <Button x:Name="AlertHistoryNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="◷   Alert history" Click="AlertHistoryNavButton_Click"/>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource SidebarNavButton}"
                            Content="⚙   Settings" Click="SettingsNavButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text=" Local test mode" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="v0.1 • First build" FontSize="10"
                               Foreground="{DynamicResource Hex64748BBrush}" Margin="3,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid x:Name="OverviewPage" Grid.Column="1" Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Endpoint monitor" FontSize="27" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Run a real HTTP check and see whether a service responds."
                               FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{DynamicResource Hex75602ABrush}" Background="{DynamicResource Hex302713Brush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,9"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="MANUAL CHECKS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource HexFDE68ABrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Summary cards -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CHECKS RUN" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ChecksRunText" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/>
                        <TextBlock Text="This session" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="LATEST RESULT" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="LastResultSummaryText" Text="Not checked" FontSize="22"
                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                   Margin="0,10,0,3"/>
                        <TextBlock Text="Updates after each check" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="16">
                    <StackPanel>
                        <TextBlock Text="RESPONSE TIME" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ResponseTimeSummaryText" Text="—" FontSize="28"
                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                   Margin="0,7,0,0"/>
                        <TextBlock Text="Time to receive response headers" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Main panels -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <!-- Endpoint check -->
                <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Check a service" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Enter a public website or API endpoint to test its HTTP response."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock Text="ENDPOINT URL" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="EndpointTextBox" Text="https://example.com"
                                     AutomationProperties.Name="Endpoint URL"
                                     KeyDown="EndpointTextBox_KeyDown"/>
                        </StackPanel>

                        <Button x:Name="CheckEndpointButton" Grid.Row="2"
                                Content="Check endpoint" Click="CheckEndpoint_Click"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>

                        <Border Grid.Row="3" Background="{DynamicResource Hex0B1425Brush}" CornerRadius="9"
                                Padding="14" Margin="0,22,0,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusIndicator" Width="9" Height="9"
                                             Fill="{DynamicResource NeutralBrush}"
                                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="CheckStatusText" Text="Ready to check"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="LastResultText"
                                           Text="No request has been sent yet."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock x:Name="ResponseTimeText" Text="Response time: —"
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="4" Margin="0,22,0,10">
                            <TextBlock Text="Recent checks" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="The latest 10 attempts appear here."
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="HistoryList" Grid.Row="5"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource MutedBrush}"
                                 FontSize="11" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <!-- Scope and next steps -->
                <StackPanel Grid.Column="1">
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="What this test tells you" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Healthy means the endpoint returned a 2xx HTTP status. Other HTTP responses, connection failures, and timeouts are shown separately."
                                       FontSize="12" LineHeight="19"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="2xx — successful HTTP response" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="4xx / 5xx — HTTP error response" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Timeout / unreachable — no usable response" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Hex162743Brush}" BorderBrush="{DynamicResource Hex294568Brush}" BorderThickness="1"
                            CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Incident overview" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Failed checks create incidents, and successful checks can resolve them."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OverviewOpenIncidentsCountText" Text="0 open incidents"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0"/>
                            <Button Content="Open incidents" Style="{StaticResource SecondaryButton}"
                                    Click="IncidentsNavButton_Click" HorizontalAlignment="Left"
                                    Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Prototype • Checks run only when you click the button."
                               FontSize="10" Foreground="{DynamicResource Hex64748BBrush}" TextWrapping="Wrap"
                               Margin="4,14,4,0"/>
                </StackPanel>
            </Grid>
        </Grid>

    <Grid x:Name="IncidentsPage" Grid.Column="1" Margin="28,25,28,25" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="OPERATIONS  /  INCIDENT RESPONSE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NeutralBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Incident Management" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Investigate failures, document root cause, and track service recovery." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CardBrush}" BorderThickness="1" CornerRadius="9" Padding="12,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel><TextBlock Text="INCIDENT WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="MariaDB-backed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/></StackPanel></StackPanel>
            </Border>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="OPEN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="OpenIncidentCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/><TextBlock Text="Requires attention" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/></StackPanel></Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="CRITICAL OPEN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CriticalIncidentCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/><TextBlock Text="Highest severity" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/></StackPanel></Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,8,0"><StackPanel><TextBlock Text="TOTAL RECORDED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="TotalIncidentCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/><TextBlock Text="All incidents" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/></StackPanel></Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="DONE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="DoneIncidentCountText" Text="0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/><TextBlock Text="Resolved or closed" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Incident queue" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="IncidentFilterDescriptionText" Text="Showing open incidents" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource Hex0B1425Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,5" VerticalAlignment="Center"><TextBlock x:Name="IncidentQueueCountText" Text="0 items" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/></Border></Grid>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Grid Height="37">
                            <TextBox x:Name="IncidentSearchTextBox" Height="37" Padding="10,8,36,8" FontSize="12" ToolTip="Search incident ID, title, endpoint, error details, or reason"/>
                            <TextBlock x:Name="IncidentSearchPlaceholderText" Text="Search ID, endpoint, title, error, or reason" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,36,0" IsHitTestVisible="False"/>
                            <Button x:Name="ClearIncidentSearchButton" Content="×" Width="26" Height="26" Padding="0" FontSize="17" FontWeight="Normal" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Clear search" Visibility="Collapsed" Click="ClearIncidentSearchButton_Click"/>
                        </Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="OpenIncidentsFilterButton" Content="Open" Style="{StaticResource SecondaryButton}" Click="OpenIncidentsFilterButton_Click" Margin="0,0,6,0" Padding="10,7" FontSize="11"/>
                            <Button x:Name="AllIncidentsFilterButton" Grid.Column="1" Content="All" Style="{StaticResource SecondaryButton}" Click="AllIncidentsFilterButton_Click" Margin="0,0,8,0" Padding="10,7" FontSize="11"/>
                            <ComboBox x:Name="IncidentSeverityFilterComboBox" Grid.Column="2" Height="34" MinWidth="105" Margin="0,0,5,0" HorizontalAlignment="Stretch" Background="{DynamicResource Hex0B1425Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" SelectedIndex="0" ToolTip="Filter by severity">
                                <ComboBox.ItemContainerStyle><Style TargetType="{x:Type ComboBoxItem}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="8,6"/></Style></ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="All severities"/><ComboBoxItem Content="Critical"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Low"/>
                            </ComboBox>
                            <ComboBox x:Name="IncidentSortComboBox" Grid.Column="3" Height="34" MinWidth="105" HorizontalAlignment="Stretch" Background="{DynamicResource Hex0B1425Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" SelectedIndex="0" ToolTip="Change incident queue order">
                                <ComboBox.ItemContainerStyle><Style TargetType="{x:Type ComboBoxItem}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="8,6"/></Style></ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="Priority first"/><ComboBoxItem Content="Newest first"/><ComboBoxItem Content="Most frequent"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="IncidentsListBox" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource IncidentListBoxItemStyle}" SelectionChanged="IncidentsListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"><Border Background="{Binding SeverityBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,8,0"><TextBlock Text="{Binding SeverityDisplay}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Hex0B1120Brush}"/></Border><TextBlock Text="{Binding IncidentNumber}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding StatusBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,9,0,0" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" MaxHeight="40"/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding EndpointUrl}" FontSize="10" Margin="0,5,0,0" Foreground="{DynamicResource NeutralBrush}" TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ActivityDisplay}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding OccurrenceCount, StringFormat={}{0} events}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/></Grid>
                                </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="IncidentsEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270" Margin="22" IsHitTestVisible="False"><TextBlock Text="No incidents found" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/><TextBlock x:Name="IncidentsEmptyText" Text="Failed endpoint checks will appear here automatically." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17">
                <Grid>
                    <StackPanel x:Name="IncidentNoSelectionPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="25"><Border Width="54" Height="54" CornerRadius="15" Background="{DynamicResource Hex20385FBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"><TextBlock Text="!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource HexEAF2FFBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Select an incident" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/><TextBlock Text="Choose an item from the queue to inspect diagnostics, record root cause, and document resolution." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                    <ScrollViewer x:Name="IncidentDetailScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="INVESTIGATION RECORD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource NeutralBrush}" Margin="0,0,0,7"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
                        <TextBlock x:Name="SelectedIncidentTitleText" Text="Incident title" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock x:Name="SelectedIncidentIdText" Text="INC-000000" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="Copy ID" Style="{StaticResource SecondaryButton}" Click="CopyIncidentIdButton_Click" FontSize="10" Padding="8,4" Margin="9,0,0,0" ToolTip="Copy the incident ID"/>
                        </StackPanel>
                    </StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0"><Border x:Name="SelectedIncidentSeverityBadge" CornerRadius="5" Padding="8,4" HorizontalAlignment="Right"><TextBlock x:Name="SelectedIncidentSeverityText" Text="High" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Hex0B1120Brush}"/></Border><Border x:Name="SelectedIncidentStatusBadge" CornerRadius="5" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Right"><TextBlock x:Name="SelectedIncidentStatusText" Text="Open" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Hex0B1120Brush}"/></Border></StackPanel></Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="INCIDENT PRIORITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Set triage level" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="SelectedIncidentSeverityComboBox" Grid.Column="1" Height="35" VerticalAlignment="Center" MinWidth="110" Background="{DynamicResource Hex0B1425Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Choose a new severity level">
                                    <ComboBox.ItemContainerStyle><Style TargetType="{x:Type ComboBoxItem}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="8,6"/></Style></ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="Critical"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Low"/>
                                </ComboBox>
                                <Button x:Name="ApplyIncidentSeverityButton" Grid.Column="2" Content="Update priority" Style="{StaticResource SecondaryButton}" Click="ApplyIncidentSeverityButton_Click" IsEnabled="False" Padding="10,8" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="AFFECTED ENDPOINT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/><Border Background="{DynamicResource Hex0B1425Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SelectedIncidentEndpointText" Text="—" FontSize="11" Foreground="{DynamicResource NeutralBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,3,8,3"/>
                                    <Button Grid.Column="1" Content="Copy endpoint" Style="{StaticResource SecondaryButton}" Click="CopyIncidentEndpointButton_Click" FontSize="10" Padding="8,6" VerticalAlignment="Center" ToolTip="Copy the affected endpoint URL"/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,5,5"><StackPanel><TextBlock Text="FIRST DETECTED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedIncidentFirstSeenText" Text="—" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5,0,0,5"><StackPanel><TextBlock Text="LATEST FAILURE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedIncidentLastSeenText" Text="—" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,5,5,0"><StackPanel><TextBlock Text="FAILURE EVENTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedIncidentOccurrencesText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5,5,0,0"><StackPanel><TextBlock Text="LAST RESOLVED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SelectedIncidentResolvedAtText" Text="Not resolved" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="DETECTED TECHNICAL DETAILS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,7"/><Border Background="{DynamicResource Hex0B1425Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11"><TextBlock x:Name="SelectedIncidentTechnicalDetailsText" Text="No technical details recorded." FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></Border>
                            <Grid Margin="0,17,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROOT CAUSE / REASON" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Record what is confirmed; label assumptions clearly." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="OPERATOR NOTES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource NeutralBrush}" VerticalAlignment="Top" Margin="8,1,0,0"/></Grid>
                            <TextBox x:Name="IncidentReasonTextBox" MinHeight="100" Padding="11" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Describe the confirmed cause, investigation findings, or current hypothesis"/><TextBlock x:Name="IncidentDetailFeedbackText" Text="Reason notes are saved to MariaDB when you choose Save reason." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="LIFECYCLE SUMMARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,17,0,7"/><Border Background="{DynamicResource Hex101B2FBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11"><TextBlock x:Name="SelectedIncidentTimelineText" Text="—" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></Border>
                            <TextBlock Text="RESOLUTION NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,7"/>
                            <TextBlock Text="Record the fix, validation performed, and any follow-up work." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" TextWrapping="Wrap"/>
                            <TextBox x:Name="IncidentResolutionTextBox" MinHeight="78" Padding="11" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Document the resolution and how recovery was verified"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="SaveIncidentResolutionButton" Content="Save resolution notes" Style="{StaticResource SecondaryButton}" Click="SaveIncidentResolutionButton_Click" IsEnabled="False" Padding="11,7" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,2"><Button x:Name="SaveIncidentReasonButton" Content="Save reason" Click="SaveIncidentReasonButton_Click" IsEnabled="False" Padding="13,9" Margin="0,0,7,0"/><Button x:Name="MarkDoneIncidentButton" Content="Mark as done" Click="MarkDoneIncidentButton_Click" IsEnabled="False" Padding="13,9" Margin="0,0,7,0"/><Button x:Name="ReopenIncidentButton" Content="Reopen" Style="{StaticResource SecondaryButton}" Click="ReopenIncidentButton_Click" IsEnabled="False" Padding="13,9"/></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Grid x:Name="AlertHistoryPage" Grid.Column="1" Margin="28,25,28,25" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Alert history" FontSize="27" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="A local record of endpoint checks and their outcomes."
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="15" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Recent check events" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Up to 200 entries are kept on this computer."
                               FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="HistoryCountText" Grid.Column="1" Text="0 records"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18">
            <Grid>
                <ListBox x:Name="HistoryEntriesList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Delete history entry"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Hex101A2BBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.RowSpan="2" Text="{Binding TimestampDisplay}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details}"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding ResultBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding ResponseTimeDisplay}" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryEmptyText" Text="No checks yet. Run a check from Endpoint checker."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </Grid>
    <Grid x:Name="ScheduledChecksPage" Grid.Column="1" Margin="30,24,30,24" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MONITORING  /  AUTOMATION" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource NeutralBrush}" Margin="0,0,0,7"/>
                <TextBlock Text="Scheduled checks" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Build a target list, choose your cadence, and let the monitor run the checks."
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Hex0B1425Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,11" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ScheduleStatusIndicator" Width="9" Height="9"
                             Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <StackPanel>
                        <TextBlock Text="SCHEDULER" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="ScheduleStatusBadgeText" Text="PAUSED" FontSize="11"
                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Target editor and cadence controls -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="18" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="118"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9"
                                Background="{DynamicResource Hex20385FBrush}" VerticalAlignment="Center">
                            <TextBlock Text="01" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource HexEAF2FFBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Monitoring targets" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="One URL or domain per line" FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="7" Padding="9,5"
                                Background="{DynamicResource Hex0B1425Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ScheduledEndpointCountText" Text="0 endpoints"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Paste multiple addresses below. A domain without a scheme is checked over HTTPS."
                               FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="ScheduleEndpointsTextBox" Grid.Row="2" Height="118"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" AutomationProperties.Name="Scheduled endpoint list"
                             FontFamily="Consolas" FontSize="12" Padding="11,9"/>
                    <Grid Grid.Row="3" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SaveScheduleButton" Content="Save targets"
                                Click="SaveScheduleButton_Click" HorizontalAlignment="Left"
                                Padding="14,10"/>
                        <Button x:Name="RunScheduledNowButton" Grid.Column="1" Content="▶  Run all now"
                                Style="{StaticResource SecondaryButton}"
                                Click="RunScheduledNowButton_Click" Padding="13,10"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="32" Height="32" CornerRadius="9"
                                Background="{DynamicResource Hex302713Brush}" VerticalAlignment="Center">
                            <TextBlock Text="02" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource HexFDE68ABrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Check cadence" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Pick a repeat interval" FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Every" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="ScheduleIntervalTextBox" Grid.Column="1" Text="5"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Schedule interval value" Padding="8,9"/>
                        <Border Grid.Column="2" Margin="9,0,0,0" Padding="3"
                                Background="{DynamicResource Hex0B1425Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScheduleSecondsUnitButton" Content="Seconds"
                                        Style="{StaticResource ScheduleUnitSegmentButton}"
                                        Click="ScheduleSecondsUnitButton_Click"
                                        AutomationProperties.Name="Use seconds as schedule unit"/>
                                <Button x:Name="ScheduleMinutesUnitButton" Grid.Column="1" Content="Minutes"
                                        Style="{StaticResource ScheduleUnitSegmentButton}"
                                        Click="ScheduleMinutesUnitButton_Click"
                                        AutomationProperties.Name="Use minutes as schedule unit"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartScheduleButton" Content="▶  Start schedule"
                                Click="StartScheduleButton_Click" Margin="0,0,5,0"
                                HorizontalAlignment="Stretch" Padding="10,10"/>
                        <Button x:Name="PauseScheduleButton" Grid.Column="1" Content="Ⅱ  Pause"
                                Style="{StaticResource SecondaryButton}"
                                Click="PauseScheduleButton_Click" Margin="5,0,0,0"
                                HorizontalAlignment="Stretch" Padding="10,10"/>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource Hex0B1425Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="{DynamicResource Hex18253BBrush}"
                                    VerticalAlignment="Top" Margin="0,0,11,0">
                                <TextBlock Text="◷" FontSize="19"
                                           Foreground="{DynamicResource NeutralBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="NEXT CHECK" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="ScheduleNextRunText" Text="Not scheduled"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0"/>
                                <TextBlock x:Name="ScheduleStatusText" Text="Add targets and start the schedule."
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Live results -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Endpoint status" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Live results from manual batch runs and automatic scans."
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="7" Padding="9,5"
                            Background="{DynamicResource Hex0B1425Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="HTTP / HTTPS" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="10,0,10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="ENDPOINT" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="LAST CHECK" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="STATUS" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}" Margin="12,0,18,0"/>
                    <TextBlock Grid.Column="4" Text="LATENCY" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="ScheduledEndpointsList" Background="Transparent" BorderThickness="0"
                             Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Hex101A2BBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="10,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.35*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding ResultBrush}"
                                                CornerRadius="2" Margin="0,1,0,1"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock Text="{Binding Endpoint}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LastCheckedDisplay}" FontSize="9"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LastCheckedAt, StringFormat='{}{0:MMM dd, HH:mm:ss}'}"
                                                   FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="3" CornerRadius="6" Padding="8,5"
                                                Background="{DynamicResource Hex0B1425Brush}"
                                                BorderBrush="{Binding ResultBrush}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="12,0,16,0">
                                            <TextBlock Text="{Binding LastResult}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding ResultBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding ResponseTimeDisplay}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ScheduledEndpointsEmptyText"
                               Text="No targets yet. Add a few URLs above, save the list, and start a scan."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Grid x:Name="SettingsPage" Grid.Column="1" Margin="32,28,32,28" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Personalize the AlertingSystem workspace." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="ThemeDescriptionText" Text="Choose a theme for the application." FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DarkThemeOption" Grid.Column="0" Style="{StaticResource ThemeOptionRadioButton}"
                                 GroupName="ApplicationTheme" IsChecked="True" Checked="DarkThemeOption_Checked">
                        <StackPanel>
                            <TextBlock Text="Dark" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="A focused, low-light workspace." FontSize="12" Margin="0,7,0,0"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LightThemeOption" Grid.Column="1" Style="{StaticResource ThemeOptionRadioButton}"
                                 GroupName="ApplicationTheme" IsChecked="False" Checked="LightThemeOption_Checked">
                        <StackPanel>
                            <TextBlock Text="Light" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="A bright, clean workspace." FontSize="12" Margin="0,7,0,0"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Your preference is saved on this computer." FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
