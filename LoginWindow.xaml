<Window x:Class="AlertingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem | Secure access"
        Width="1000" Height="700"
        MinWidth="1000" MinHeight="700" MaxWidth="1000" MaxHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#080F1D"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0D1729"/>
            <Setter Property="Foreground" Value="#F3F6FC"/>
            <Setter Property="BorderBrush" Value="#25354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#315FE5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#5C8CFF"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#101D33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#0D1729"/>
            <Setter Property="Foreground" Value="#F3F6FC"/>
            <Setter Property="BorderBrush" Value="#25354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#5C8CFF"/>
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#101D33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#315FE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C8CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A7C0FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.90*"/>
            <ColumnDefinition Width="1.10*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1424"
                BorderBrush="#25354D" BorderThickness="1"
                CornerRadius="20" Padding="36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#4F83FF">
                        <TextBlock Text="A" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AlertingSystem" FontSize="17"
                                   FontWeight="Bold" Foreground="#F3F6FC"/>
                        <TextBlock Text="INCIDENT OPERATIONS" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#A1B0C8" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="One workspace.&#10;Better incident response."
                               FontSize="29" FontWeight="Bold" Foreground="#F3F6FC"
                               LineHeight="38" TextWrapping="Wrap"/>
                    <TextBlock Text="Sign in to monitor endpoints, investigate alerts, and keep incident history in one shared workspace."
                               FontSize="13" Foreground="#A1B0C8" LineHeight="21"
                               TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <Border Height="1" Background="#263650" Margin="0,26,0,23"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <Ellipse Width="8" Height="8" Fill="#3DD9A0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="MariaDB-backed workspace" FontSize="12" Foreground="#D8E4F5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#72A7FF"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Password hashing enabled" FontSize="12" Foreground="#D8E4F5"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="SECURE ACCESS  /  ALERTING SYSTEM"
                           FontSize="9" FontWeight="Bold" Foreground="#71829C"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#111D30"
                BorderBrush="#25354D" BorderThickness="1"
                CornerRadius="20" Padding="38" Margin="16,0,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACCOUNT ACCESS" FontSize="10"
                               FontWeight="Bold" Foreground="#79A2FF" Margin="0,0,0,12"/>
                    <TextBlock x:Name="HeadingText" Text="Welcome back"
                               FontSize="27" FontWeight="Bold" Foreground="#F3F6FC"/>
                    <TextBlock x:Name="SubheadingText"
                               Text="Sign in to continue to your workspace."
                               FontSize="12" Foreground="#A1B0C8"
                               TextWrapping="Wrap" Margin="0,7,0,22"/>

                    <StackPanel x:Name="LoginFormPanel">
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <TextBox x:Name="LoginUsernameTextBox"
                                 AutomationProperties.Name="Username"
                                 MaxLength="32" Margin="0,0,0,16"/>
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     AutomationProperties.Name="Password"
                                     KeyDown="LoginPasswordBox_KeyDown" Margin="0,0,0,20"/>
                        <Button x:Name="LoginButton" Content="Sign in"
                                Click="LoginButton_Click" Height="44"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                        <TextBlock Text="DISPLAY NAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <TextBox x:Name="RegisterDisplayNameTextBox"
                                 AutomationProperties.Name="Display name"
                                 MaxLength="100" Margin="0,0,0,12" PreviewKeyDown="RegisterInput_PreviewKeyDown"/>
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <TextBox x:Name="RegisterUsernameTextBox"
                                 AutomationProperties.Name="New username"
                                 MaxLength="32" Margin="0,0,0,12" PreviewKeyDown="RegisterInput_PreviewKeyDown"/>
                        <TextBlock Text="PASSWORD (8+ CHARACTERS)" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="RegisterPasswordBox"
                                     AutomationProperties.Name="New password" Margin="0,0,0,12" PreviewKeyDown="RegisterInput_PreviewKeyDown"/>
                        <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#A1B0C8" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     AutomationProperties.Name="Confirm password" Margin="0,0,0,16" PreviewKeyDown="RegisterInput_PreviewKeyDown"/>
                        <Button x:Name="RegisterButton" Content="Create account"
                                Click="RegisterButton_Click" Height="44"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <TextBlock x:Name="FeedbackText" Text=""
                               FontSize="11" Foreground="#FF718B"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button x:Name="ModeSwitchButton"
                            Content="New here? Create an account"
                            Click="ModeSwitchButton_Click"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="#79A2FF" HorizontalAlignment="Center"
                            Padding="6,8" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
