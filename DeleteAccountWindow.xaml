<Window x:Class="AlertingSystem.DeleteAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete account"
        Width="600" Height="470"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#080F1D"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#0D1729"/>
            <Setter Property="Foreground" Value="#F3F6FC"/>
            <Setter Property="BorderBrush" Value="#25354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#5C8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#315FE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C8CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#111D30" BorderBrush="#25354D" BorderThickness="1"
            CornerRadius="18" Padding="24" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="DELETE ACCOUNT" FontSize="10" FontWeight="Bold"
                           Foreground="#FB7185"/>
                <TextBlock Text="Delete this account?" FontSize="23" FontWeight="Bold"
                           Foreground="#F3F6FC" Margin="0,8,0,0"/>
                <TextBlock x:Name="AccountUsernameText" Text="@username" FontSize="12"
                           Foreground="#A1B0C8" Margin="0,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                <Border Background="#2A1725" BorderBrush="#8C354A" BorderThickness="1"
                        CornerRadius="10" Padding="13">
                    <TextBlock Text="Your account will be disabled, but its database row will remain for audit purposes. Incidents and alert history will not be deleted."
                               FontSize="12" LineHeight="18" Foreground="#FBD5DE"
                               TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="CONFIRM WITH YOUR CURRENT PASSWORD" FontSize="10"
                           FontWeight="Bold" Foreground="#A1B0C8"
                           Margin="0,19,0,7"/>
                <PasswordBox x:Name="ConfirmDeletePasswordBox"
                             AutomationProperties.Name="Confirm account deletion password"
                             PasswordChanged="ConfirmDeletePasswordBox_PasswordChanged"
                             KeyDown="ConfirmDeletePasswordBox_KeyDown"/>
                <TextBlock x:Name="FeedbackText" Text=""
                           FontSize="11" Foreground="#FB7185"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" IsCancel="True"
                        Background="#18263C" BorderBrush="#25354D"
                        HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Delete account"
                        Click="ConfirmDeleteButton_Click"
                        Background="#C52F4B" BorderBrush="#FB7185"/>
            </Grid>
        </Grid>
    </Border>
</Window>
