<Window x:Class="AlertingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AlertingSystem | Secure access"
        Width="900" Height="680"
        MinWidth="420" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#07151D"
        WindowStyle="None"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Subtle circuit/signal traces: a visual reference to endpoint monitoring and alert flow. -->
        <DrawingBrush x:Key="SignalPatternBrush"
                      TileMode="Tile"
                      Viewport="0,0,180,100"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,180,100"
                      ViewboxUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,24 L 30,24 L 42,36 L 76,36 L 88,24 L 125,24">
                        <GeometryDrawing.Pen><Pen Brush="#1B5663" Thickness="1.1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 180,68 L 148,68 L 136,56 L 102,56 L 90,68 L 54,68">
                        <GeometryDrawing.Pen><Pen Brush="#1B5663" Thickness="1.1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 34,0 L 34,12 L 46,24">
                        <GeometryDrawing.Pen><Pen Brush="#204450" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 118,24 L 118,12 L 130,12">
                        <GeometryDrawing.Pen><Pen Brush="#204450" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 76,36 L 76,48 L 64,60">
                        <GeometryDrawing.Pen><Pen Brush="#204450" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 148,68 L 148,82 L 136,94">
                        <GeometryDrawing.Pen><Pen Brush="#204450" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0EBAC8">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="42,36" RadiusX="2.2" RadiusY="2.2"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0EBAC8">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="136,56" RadiusX="2.2" RadiusY="2.2"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#193A45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#D9485F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="CardBrush" Color="#102630"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#0A1B24"/>
        <SolidColorBrush x:Key="LineBrush" Color="#26434D"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0EBAC8"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#46D6DE"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8F6F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91ADB6"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#098A98"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#132C38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#132C38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9DECF0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoginSubmitButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="ButtonBase.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.96" Duration="0:0:0.08" AutoReverse="True"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.96" Duration="0:0:0.08" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="42"
                Background="#0B1C25"
                BorderBrush="#26434D"
                BorderThickness="0,0,0,1"
                ClipToBounds="True">
            <Grid>
                <Border Background="{StaticResource SignalPatternBrush}" Opacity="0.65" IsHitTestVisible="False"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="23" Height="23" CornerRadius="7"
                                Background="#0EBAC8" Margin="0,0,10,0">
                            <TextBlock Text="A" Foreground="White" FontSize="15"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ALERTINGSYSTEM" Foreground="#E8F6F8"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="16" Background="#31505D" Margin="13,0"/>
                        <Ellipse Width="6" Height="6" Fill="#47D7AA" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="SECURE MONITORING" Foreground="#91ADB6"
                                   FontSize="9" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="—" ToolTip="Minimize"
                                Click="MinimizeWindowButton_Click"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="□" ToolTip="Maximize / restore"
                                Click="MaximizeWindowButton_Click"/>
                        <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="×" ToolTip="Close"
                                Click="CloseWindowButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20" Background="#07151D">
            <Border Background="{StaticResource SignalPatternBrush}" Opacity="0.35" IsHitTestVisible="False"/>
        <Border MaxWidth="440"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Welcome to the AlertingSystem"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Grid>
                        <StackPanel x:Name="LoginFormPanel">
                            <TextBlock Text="Username"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="LoginUsernameTextBox"
                                     AutomationProperties.Name="Username"
                                     MaxLength="32"
                                     HorizontalAlignment="Stretch"
                                     KeyDown="LoginUsernameTextBox_KeyDown"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Password"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,7"/>
                            <PasswordBox x:Name="LoginPasswordBox"
                                         AutomationProperties.Name="Password"
                                         KeyDown="LoginPasswordBox_KeyDown"
                                         Margin="0,0,0,20"/>

                            <Button x:Name="LoginButton"
                                    Style="{StaticResource LoginSubmitButtonStyle}"
                                    Content="Sign in"
                                    Click="LoginButton_Click"
                                    Height="46"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                            <TextBlock Text="Display name"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterDisplayNameTextBox"
                                     AutomationProperties.Name="Display name"
                                     MaxLength="100"
                                     Margin="0,0,0,11"
                                     PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Username"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="RegisterUsernameTextBox"
                                     AutomationProperties.Name="New username"
                                     MaxLength="32"
                                     Margin="0,0,0,11"
                                     PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Password (8+ characters)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="RegisterPasswordBox"
                                         AutomationProperties.Name="New password"
                                         Margin="0,0,0,11"
                                         PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <TextBlock Text="Confirm password"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         AutomationProperties.Name="Confirm password"
                                         Margin="0,0,0,15"
                                         PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                            <Button x:Name="RegisterButton"
                                    Content="Create account"
                                    Click="RegisterButton_Click"
                                    Height="46"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock x:Name="FeedbackText"
                               Text=""
                               FontSize="11"
                               Foreground="#FF879B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <Button x:Name="ModeSwitchButton"
                            Content="New here? Create an account"
                            Click="ModeSwitchButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#9DECF0"
                            HorizontalAlignment="Center"
                            Padding="8,7"
                            MinHeight="34"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
