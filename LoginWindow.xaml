<Window x:Class="AlertingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem | Secure access"
        Width="940" Height="650"
        MinWidth="940" MinHeight="650" MaxWidth="940" MaxHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0A1020"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#0B1425"/>
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="BorderBrush" Value="#263650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#0B1425"/>
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="BorderBrush" Value="#263650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#477DFA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5C8CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*"/>
            <ColumnDefinition Width="1.08*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D1628"
                BorderBrush="#263650" BorderThickness="1"
                CornerRadius="16" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#477DFA">
                        <TextBlock Text="A" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AlertingSystem" FontSize="17"
                                   FontWeight="Bold" Foreground="#F1F5FC"/>
                        <TextBlock Text="INCIDENT OPERATIONS" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#9AAAC2" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="One workspace.&#10;Better incident response."
                               FontSize="29" FontWeight="Bold" Foreground="#F1F5FC"
                               LineHeight="38" TextWrapping="Wrap"/>
                    <TextBlock Text="Sign in to monitor endpoints, investigate alerts, and keep incident history in one shared workspace."
                               FontSize="13" Foreground="#9AAAC2" LineHeight="21"
                               TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <Border Height="1" Background="#263650" Margin="0,26,0,23"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                        <Ellipse Width="8" Height="8" Fill="#3DD9A0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="MariaDB-backed workspace" FontSize="12" Foreground="#D8E4F5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#72A7FF"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Password hashing enabled" FontSize="12" Foreground="#D8E4F5"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="SECURE ACCESS  /  ALERTING SYSTEM"
                           FontSize="9" FontWeight="Bold" Foreground="#71829C"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#121E33"
                BorderBrush="#263650" BorderThickness="1"
                CornerRadius="16" Padding="36" Margin="14,0,0,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ACCOUNT ACCESS" FontSize="10"
                               FontWeight="Bold" Foreground="#72A7FF" Margin="0,0,0,12"/>
                    <TextBlock x:Name="HeadingText" Text="Welcome back"
                               FontSize="27" FontWeight="Bold" Foreground="#F1F5FC"/>
                    <TextBlock x:Name="SubheadingText"
                               Text="Sign in to continue to your workspace."
                               FontSize="12" Foreground="#9AAAC2"
                               TextWrapping="Wrap" Margin="0,7,0,22"/>

                    <StackPanel x:Name="LoginFormPanel">
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <TextBox x:Name="LoginUsernameTextBox"
                                 AutomationProperties.Name="Username"
                                 MaxLength="32" Margin="0,0,0,16"/>
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     AutomationProperties.Name="Password"
                                     KeyDown="LoginPasswordBox_KeyDown" Margin="0,0,0,20"/>
                        <Button x:Name="LoginButton" Content="Sign in"
                                Click="LoginButton_Click" Height="44"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                        <TextBlock Text="DISPLAY NAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <TextBox x:Name="RegisterDisplayNameTextBox"
                                 AutomationProperties.Name="Display name"
                                 MaxLength="100" Margin="0,0,0,12"/>
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <TextBox x:Name="RegisterUsernameTextBox"
                                 AutomationProperties.Name="New username"
                                 MaxLength="32" Margin="0,0,0,12"/>
                        <TextBlock Text="PASSWORD (8+ CHARACTERS)" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="RegisterPasswordBox"
                                     AutomationProperties.Name="New password" Margin="0,0,0,12"/>
                        <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#9AAAC2" Margin="0,0,0,7"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     AutomationProperties.Name="Confirm password" Margin="0,0,0,16"/>
                        <Button x:Name="RegisterButton" Content="Create account"
                                Click="RegisterButton_Click" Height="44"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <TextBlock x:Name="FeedbackText" Text=""
                               FontSize="11" Foreground="#FF718B"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button x:Name="ModeSwitchButton"
                            Content="New here? Create an account"
                            Click="ModeSwitchButton_Click"
                            Background="Transparent" BorderBrush="Transparent"
                            Foreground="#72A7FF" HorizontalAlignment="Center"
                            Padding="6,8" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
