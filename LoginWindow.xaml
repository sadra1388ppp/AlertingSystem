<Window x:Class="AlertingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlertingSystem | Secure access"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#080D18"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="AuthTextBrush" Color="#F2F6FF"/>
        <SolidColorBrush x:Key="AuthMutedBrush" Color="#91A2BC"/>
        <SolidColorBrush x:Key="AuthBorderBrush" Color="#283750"/>
        <SolidColorBrush x:Key="AuthInputBrush" Color="#0A1322"/>
        <SolidColorBrush x:Key="AuthBlueBrush" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="AuthGreenBrush" Color="#44D7A4"/>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AuthMutedBrush}"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource AuthInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AuthTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#315FE5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AuthBlueBrush}"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#0D1A2D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{StaticResource AuthInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AuthTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AuthBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource AuthBlueBrush}"/>
                                <Setter TargetName="PasswordBorder" Property="Background" Value="#0D1A2D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#416FF1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#416FF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A9C1FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthLinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8EB0FF"/>
            <Setter Property="Padding" Value="5,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#101827"
                BorderBrush="#223149"
                BorderThickness="1"
                CornerRadius="25"
                Padding="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*"/>
                    <ColumnDefinition Width="0.97*"/>
                </Grid.ColumnDefinitions>

                <!-- Left brand panel -->
                <Border Grid.Column="0"
                        Background="#0D1728"
                        CornerRadius="24,0,0,24"
                        Padding="38,34,34,30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="14"
                                    BorderBrush="#789EFF" BorderThickness="1"
                                    Background="#3769E8">
                                <Grid>
                                    <Ellipse Width="28" Height="28"
                                             Stroke="#BFD0FF" StrokeThickness="1"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="A" FontSize="23" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AlertingSystem" FontSize="18"
                                           FontWeight="Bold" Foreground="{StaticResource AuthTextBrush}"/>
                                <TextBlock Text="INCIDENT OPERATIONS" FontSize="9"
                                           FontWeight="Bold" CharacterSpacing="120"
                                           Foreground="#8094B3" Margin="1,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,28,0,28">
                            <Border HorizontalAlignment="Left"
                                    Background="#132541"
                                    BorderBrush="#27446E"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="11,6"
                                    Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AuthGreenBrush}"
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="YOUR OPERATIONS, IN FOCUS"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="#C3D4F1"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="See the signal.&#10;Take control."
                                       FontSize="39" LineHeight="46"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AuthTextBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="One calm workspace for endpoint health, incident response, and a clear history of what happened."
                                       FontSize="13" LineHeight="21"
                                       Foreground="#9BAEC9"
                                       TextWrapping="Wrap"
                                       Margin="0,17,0,0"
                                       MaxWidth="410"/>

                            <Border Background="#111E32"
                                    BorderBrush="#263A57"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16"
                                    Margin="0,28,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36" Height="36" CornerRadius="11"
                                            Background="#1B3151"
                                            BorderBrush="#304F7D" BorderThickness="1">
                                        <TextBlock Text="01" FontSize="11" FontWeight="Bold"
                                                   Foreground="#BBD0FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Endpoint monitoring" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AuthTextBrush}"/>
                                        <TextBlock Text="Run checks manually or on a schedule"
                                                   FontSize="10.5" Foreground="#8FA2BE"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="1" Width="36" Height="36" CornerRadius="11"
                                            Background="#1B3151"
                                            BorderBrush="#304F7D" BorderThickness="1"
                                            Margin="0,14,0,0">
                                        <TextBlock Text="02" FontSize="11" FontWeight="Bold"
                                                   Foreground="#BBD0FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,14,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Incident tracking" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AuthTextBrush}"/>
                                        <TextBlock Text="Keep failures, progress, and resolution together"
                                                   FontSize="10.5" Foreground="#8FA2BE"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Row="2" Width="36" Height="36" CornerRadius="11"
                                            Background="#1B3151"
                                            BorderBrush="#304F7D" BorderThickness="1"
                                            Margin="0,14,0,0">
                                        <TextBlock Text="03" FontSize="11" FontWeight="Bold"
                                                   Foreground="#BBD0FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,14,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Traceable access" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AuthTextBrush}"/>
                                        <TextBlock Text="Keep account activity in the audit history"
                                                   FontSize="10.5" Foreground="#8FA2BE"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BUILT FOR CLARITY"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#7085A4" CharacterSpacing="100"/>
                                <TextBlock Text="Monitor. Investigate. Resolve."
                                           FontSize="10.5" Foreground="#9BAEC9"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="#263A57"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="8,6" VerticalAlignment="Center">
                                <TextBlock Text="v0.1" FontSize="9" FontWeight="Bold"
                                           Foreground="#8FA2BE"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right sign-in / registration panel -->
                <Border Grid.Column="1"
                        Background="#0A1220"
                        CornerRadius="0,24,24,0"
                        Padding="34,30,34,25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SECURE ACCESS" FontSize="9"
                                           FontWeight="Bold" CharacterSpacing="100"
                                           Foreground="#88A9FF"/>
                                <TextBlock Text="Your workspace awaits."
                                           FontSize="25" FontWeight="Bold"
                                           Foreground="{StaticResource AuthTextBrush}"
                                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock Text="Sign in to pick up where you left off."
                                           FontSize="11.5" Foreground="{StaticResource AuthMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#10291F"
                                    BorderBrush="#22563F"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="10,7"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AuthGreenBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="READY" FontSize="9" FontWeight="Bold"
                                               Foreground="#A9E8CE"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <Grid>
                                <StackPanel x:Name="LoginFormPanel">
                                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid Margin="0,0,0,18">
                                        <TextBox x:Name="LoginUsernameTextBox"
                                                 AutomationProperties.Name="Username"
                                                 MaxLength="32"
                                                 Padding="42,11,13,11"
                                                 KeyDown="LoginPasswordBox_KeyDown"/>
                                        <Border Width="28" Height="28"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="9,0,0,0"
                                                Background="#14243B" CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="@" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#9BB6F4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabelStyle}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Case-sensitive" FontSize="9"
                                                   Foreground="#627590" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,22">
                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     AutomationProperties.Name="Password"
                                                     Padding="42,11,13,11"
                                                     KeyDown="LoginPasswordBox_KeyDown"/>
                                        <Border Width="28" Height="28"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="9,0,0,0"
                                                Background="#14243B" CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <TextBlock Text="••" FontSize="10" FontWeight="Bold"
                                                       Foreground="#9BB6F4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <Button x:Name="LoginButton"
                                            Content="Sign in to workspace"
                                            Click="LoginButton_Click"
                                            Height="48"
                                            HorizontalAlignment="Stretch">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4A78F3" Offset="0"/>
                                                <GradientStop Color="#3159D8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>

                                    <Border Height="1" Background="#1F2D43" Margin="0,24,0,18"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Protected account access"
                                                   FontSize="10.5" Foreground="#8194B1"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Width="3" Height="3" Fill="#4F6584"
                                                 Margin="9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Password hashing enabled"
                                                   FontSize="10.5" Foreground="#8194B1"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                                    <TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RegisterDisplayNameTextBox"
                                             AutomationProperties.Name="Display name"
                                             MaxLength="100"
                                             Margin="0,0,0,14"
                                             PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="RegisterUsernameTextBox"
                                             AutomationProperties.Name="New username"
                                             MaxLength="32"
                                             Margin="0,0,0,14"
                                             PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                                    <TextBlock Text="PASSWORD  /  8+ CHARACTERS" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="RegisterPasswordBox"
                                                 AutomationProperties.Name="New password"
                                                 Margin="0,0,0,14"
                                                 PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabelStyle}"/>
                                    <PasswordBox x:Name="ConfirmPasswordBox"
                                                 AutomationProperties.Name="Confirm password"
                                                 Margin="0,0,0,20"
                                                 PreviewKeyDown="RegisterInput_PreviewKeyDown"/>

                                    <Button x:Name="RegisterButton"
                                            Content="Create account"
                                            Click="RegisterButton_Click"
                                            Height="48"
                                            HorizontalAlignment="Stretch">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#4A78F3" Offset="0"/>
                                                <GradientStop Color="#3159D8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                    <TextBlock Text="Your account will be protected with a salted password hash."
                                               FontSize="10" Foreground="#8194B1"
                                               TextWrapping="Wrap" Margin="0,15,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="FeedbackText" Text=""
                                       FontSize="11" Foreground="#FF8295"
                                       TextWrapping="Wrap" Margin="2,0,2,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NEW TO ALERTINGSYSTEM?"
                                               FontSize="9" FontWeight="Bold"
                                               CharacterSpacing="60"
                                               Foreground="#6F829E"/>
                                    <TextBlock Text="Create your workspace account"
                                               FontSize="10.5" Foreground="#91A2BC"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="ModeSwitchButton"
                                        Grid.Column="1"
                                        Content="Create account  →"
                                        Click="ModeSwitchButton_Click"
                                        Style="{StaticResource AuthLinkButton}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"/>
                            </Grid>
                            <Border Height="1" Background="#1F2D43" Margin="0,14,0,10"/>
                            <TextBlock Text="By continuing, you access your shared incident workspace."
                                       FontSize="9.5" Foreground="#657994"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
